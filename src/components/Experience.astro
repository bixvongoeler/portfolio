---
import { siteConfig } from "../config";
import SectionLayout from "./SectionLayout.astro";
import SectionHeader from "./SectionHeader.astro";

const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;

// Collapse only pays off when at least one full entry is hidden beyond the peeking one
const collapseCfg = siteConfig.experienceCollapse;
const visibleCount = collapseCfg?.visibleCount ?? 2;
const peekPx = collapseCfg?.peekPx ?? 112;
const collapsible = !!collapseCfg?.enabled && siteConfig.experience.length >= visibleCount + 2;
---

{
    hasExperience && (
        <SectionLayout id="experience">
            <SectionHeader title="Experience" />

            <div class="lg:col-span-8">
                <div
                    id="experience-collapse"
                    class="relative pt-2 -mt-2"
                    data-collapsible={collapsible ? "" : undefined}
                    data-visible-count={visibleCount}
                    data-peek={peekPx}
                    style={`--exp-peek: ${peekPx}px`}
                >
                    {siteConfig.experience.map((exp, index) => (
                        <div class="relative mb-12 last:mb-0" data-exp-item>
                            {/* Timeline dot at top of card */}
                            <div class={`absolute left-1/2 -top-2 w-4 h-4 rounded-full -translate-x-1/2 z-20 transition-all duration-300 ${
                                exp.highlight
                                    ? "bg-[var(--accent-color)] border-2 border-[var(--accent-color)]"
                                    : "bg-gray-400 dark:bg-slate-500 border-2 border-gray-400 dark:border-slate-500"
                            }`} />

                            {/* Connecting line below card */}
                            {index < siteConfig.experience.length - 1 && (
                                <div class="absolute left-1/2 bottom-0 w-0.5 h-12 bg-gray-300 dark:bg-slate-600 -translate-x-1/2 translate-y-full z-10" />
                            )}

                            {/* Experience card */}
                            <div
                                data-tilt={siteConfig.tiltEffect?.enabled ? "" : undefined}
                                data-tilt-max={siteConfig.tiltEffect?.max}
                                data-tilt-speed={siteConfig.tiltEffect?.speed}
                                data-tilt-perspective={siteConfig.tiltEffect?.perspective}
                                class={`rounded-lg p-4 sm:p-5 md:p-6 transition-shadow duration-300 ${
                                    exp.highlight
                                        ? "highlight-experience bg-white dark:bg-slate-800 border-2 border-[var(--accent-color)]"
                                        : "bg-gray-50 dark:bg-slate-800/60 border border-gray-200 dark:border-slate-700 shadow-sm hover:shadow-md"
                                }`}
                            >
                                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-4">
                                    <div>
                                        <h3 class="text-lg sm:text-xl font-semibold text-gray-900 dark:text-slate-50">
                                            {exp.title}
                                        </h3>
                                        <p class="text-base sm:text-lg text-[var(--accent-color)]">{exp.company}</p>
                                    </div>
                                    <span class={`text-sm sm:text-base mt-2 sm:mt-1 ${exp.highlight ? "text-gray-700 dark:text-slate-300" : "text-gray-600 dark:text-slate-400"}`}>
                                        {exp.dateRange.includes("Present") ? (
                                            <>
                                                {exp.dateRange.replace("Present", "")}
                                                <span class="text-[var(--accent-color)] font-medium">Present</span>
                                            </>
                                        ) : (
                                            exp.dateRange
                                        )}
                                    </span>
                                </div>

                                {"description" in exp && exp.description && (
                                    <p class="text-sm sm:text-base text-gray-700 dark:text-slate-300 mb-3" set:html={exp.description} />
                                )}

                                <ul class="space-y-2">
                                    {exp.bullets.map((bullet) => (
                                        <li class="flex items-start">
                                            <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 dark:bg-slate-500 mt-2 mr-3 flex-shrink-0" />
                                            <span class="text-sm sm:text-base text-gray-600 dark:text-slate-400" set:html={bullet} />
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                    ))}
                </div>

                {collapsible && (
                    <button
                        id="experience-toggle"
                        type="button"
                        aria-expanded="true"
                        aria-controls="experience-collapse"
                        class="hidden mt-8 mx-auto items-center gap-2 px-4 py-2 rounded-lg border border-gray-300 dark:border-slate-600 text-sm font-medium text-[var(--accent-color)] hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors"
                    >
                        <span data-label>Show more</span>
                        <svg
                            data-chevron
                            class="w-4 h-4 transition-transform duration-300"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            viewBox="0 0 24 24"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                )}
            </div>
        </SectionLayout>
    )
}

<style>
    .highlight-experience {
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    }

    .highlight-experience:hover {
        box-shadow: 0 20px 35px -5px rgba(0, 0, 0, 0.2), 0 10px 15px -6px rgba(0, 0, 0, 0.15);
    }

    :global(.dark) .highlight-experience {
        box-shadow: 0 10px 25px -5px rgba(255, 255, 255, 0.1), 0 8px 10px -6px rgba(255, 255, 255, 0.08);
    }

    :global(.dark) .highlight-experience:hover {
        box-shadow: 0 20px 35px -5px rgba(255, 255, 255, 0.15), 0 10px 15px -6px rgba(255, 255, 255, 0.1);
    }

    /* Collapsed state: fade content out over the peek zone. A mask (rather than a
       background-colored overlay) lets the hero's accent tint show through correctly. */
    #experience-collapse.exp-collapsed {
        -webkit-mask-image: linear-gradient(to bottom, black calc(100% - var(--exp-peek, 112px)), transparent 100%);
        mask-image: linear-gradient(to bottom, black calc(100% - var(--exp-peek, 112px)), transparent 100%);
    }

    #experience-collapse.exp-animating {
        transition: max-height 0.5s ease;
    }

    @media (prefers-reduced-motion: reduce) {
        #experience-collapse.exp-animating {
            transition: none;
        }
    }
</style>

<script>
    const wrapper = document.getElementById("experience-collapse");
    const toggle = document.getElementById("experience-toggle");

    if (wrapper && toggle && wrapper.hasAttribute("data-collapsible")) {
        const labelEl = toggle.querySelector("[data-label]");
        const chevron = toggle.querySelector("[data-chevron]");
        const items = wrapper.querySelectorAll<HTMLElement>("[data-exp-item]");
        const visibleCount = parseInt(wrapper.dataset.visibleCount ?? "2", 10);
        const peek = parseInt(wrapper.dataset.peek ?? "112", 10);
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        let expanded = true;

        // offsetTop is measured against the wrapper (its offsetParent, position: relative)
        const collapsedHeight = () => {
            const next = items[visibleCount];
            return next ? next.offsetTop + peek : wrapper.scrollHeight;
        };

        const syncToggle = () => {
            if (labelEl) labelEl.textContent = expanded ? "Show less" : "Show more";
            chevron?.classList.toggle("rotate-180", expanded);
            toggle.setAttribute("aria-expanded", String(expanded));
        };

        const collapse = () => {
            wrapper.style.maxHeight = wrapper.scrollHeight + "px";
            void wrapper.offsetHeight; // force reflow so the height transition runs
            wrapper.classList.add("overflow-y-clip", "exp-collapsed");
            wrapper.style.maxHeight = collapsedHeight() + "px";
            expanded = false;
            syncToggle();
        };

        const expand = () => {
            wrapper.classList.remove("exp-collapsed");
            wrapper.style.maxHeight = wrapper.scrollHeight + "px";
            expanded = true;
            syncToggle();
            if (reducedMotion.matches) {
                wrapper.style.maxHeight = "";
                wrapper.classList.remove("overflow-y-clip");
            }
        };

        wrapper.addEventListener("transitionend", (e) => {
            if (e.target !== wrapper || !expanded) return;
            wrapper.style.maxHeight = "";
            wrapper.classList.remove("overflow-y-clip");
        });

        // Initial state: collapsed without animation (SSR renders the full list as a no-JS fallback)
        collapse();
        toggle.classList.remove("hidden");
        toggle.classList.add("flex");
        requestAnimationFrame(() => wrapper.classList.add("exp-animating"));

        toggle.addEventListener("click", () => (expanded ? collapse() : expand()));

        let resizeTimer: number;
        window.addEventListener("resize", () => {
            clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(() => {
                if (!expanded) wrapper.style.maxHeight = collapsedHeight() + "px";
            }, 150);
        });
    }
</script>
